<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_linear_bg"
    tools:context=".presentation.welcome.onboarding.view.OnboardingFragment1">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/skipBtn1"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_margin="20dp"
        android:background="@drawable/custom_btn_onboarding"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/skip"
        android:textAllCaps="false"
        android:textColor="@color/blue_dark"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/onboardingImage1"
        android:layout_width="370dp"
        android:layout_height="300dp"
        android:layout_marginTop="50dp"
        android:contentDescription="@string/onboarding_image"
        android:scaleType="centerCrop"
        android:src="@drawable/food"
        app:layout_constraintBottom_toTopOf="@+id/descriptionTv1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/skipBtn1" />


    <LinearLayout
        android:id="@+id/dotsContainer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/descriptionTv1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onboardingImage1" />


    <TextView
        android:id="@+id/descriptionTv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/find_your_meal"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dotsContainer1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/nextBtn1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="80dp"
        android:background="@drawable/custom_btn_onboarding"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/blue_dark"
        android:textSize="23sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/descriptionTv1" />

</androidx.constraintlayout.widget.ConstraintLayout>